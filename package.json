{
  "name": "@ryanbateman/vizier-mcp",
  "version": "0.6.0",
  "description": "An helpful Vizier MCP server for understanding your Dwarf Fortress game state, via DFHack's remote API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "vizier-mcp": "./build/index.js"
  },
  "scripts": {
    "proto": "node scripts/generate-proto.mjs",
    "build": "tsc",
    "prebuild": "npm run proto",
    "prepack": "npm run proto && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "dfhack",
    "dwarf-fortress",
    "model-context-protocol"
  ],
  "author": "Ryan Bateman",
  "license": "MIT",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "generated",
    "lua",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanbateman/vizier_mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11.5.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "protobufjs": "8.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.7",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
